# Google Drive to Azure Blob Storage - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Azure Storage Configuration
# =============================================================================

# Connection string for your Azure Storage Account
# Format: DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONNECTION_STRING=

# Name of the container to store backups (will be created if it doesn't exist)
AZURE_CONTAINER=gdrive-backup

# =============================================================================
# Azure Key Vault Configuration (for Google credentials)
# =============================================================================

# Name of your Azure Key Vault (not the full URL, just the name)
KEY_VAULT_NAME=

# Name of the secret in Key Vault containing Google service account JSON
GOOGLE_APPLICATION_CREDENTIALS_SECRET_NAME=google-drive-credentials

# =============================================================================
# Google Drive Configuration
# =============================================================================

# Folder ID from Google Drive to sync
# Find this in the folder URL: https://drive.google.com/drive/folders/[FOLDER_ID]
FOLDER_ID=

# =============================================================================
# Sync Configuration
# =============================================================================

# Enable incremental sync (only sync files modified since last run)
# Set to 'true' or 'false'
INCREMENTAL_SYNC_ENABLED=true

# =============================================================================
# Optional: Local Development (alternative to Key Vault)
# =============================================================================

# Path to local Google service account JSON file (for development only)
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# =============================================================================
# Optional: Logging Configuration
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO
